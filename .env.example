# ============ 被测系统 ============
BASE_URL=http://localhost:3000
# Spree Store API 的 publishable key，pk_ 开头
API_KEY=pk_replace_me

# ============ 登录账号 ============
CUSTOMER_EMAIL=customer@example.com
CUSTOMER_PASSWORD=password123

# ============ 数据库（用于三层断言中的 DB 校验）============
# 驱动用 psycopg3：postgresql+psycopg://user:pass@host:port/dbname
DB_DSN=postgresql+psycopg://spree:spree@localhost:5432/spree_development

# ============ 运行参数 ============
TIMEOUT=30
# 1 = 把每个请求/响应都写进 Allure（默认开；接口多时可关掉减少报告体积）
ATTACH_ALL=1
# 留空则自动生成，格式 月日时分秒-随机4位；CI 里建议用 github.run_id
RUN_ID=
